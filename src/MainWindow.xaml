<Window x:Class="FluentIconStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FluentIconStudio" Icon="app.ico"
 WindowState="Maximized" ResizeMode="CanResize"
 Background="{StaticResource WindowBg}" Foreground="{StaticResource TextMain}"
 Closing="Window_Closing">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="DownloadPackButton" Content="Update Icon Library" Click="DownloadPack_Click" Margin="0,0,8,0" Padding="10,5" Background="#536FD0" BorderBrush="#6F8AF0"/>
    <Button Content="Open icon folder…" Click="OpenFolder_Click"/>
    <Button Content="Refresh" Click="Refresh_Click"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="FluentIcon Studio" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="Local icon library · SVG editing and Windows icon export" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" Height="38" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search icon filenames" Foreground="{StaticResource TextMain}" CaretBrush="White"/>
   <ComboBox x:Name="StyleFilter" Grid.Column="1" Width="135" Margin="8,0,4,0" Height="38" SelectionChanged="StyleFilter_SelectionChanged">
    <ComboBoxItem Content="All styles" IsSelected="True"/><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Filled"/><ComboBoxItem Content="Color"/><ComboBoxItem Content="Light"/>
   </ComboBox>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
    <TextBlock Text="Icon Mode:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
    <Button x:Name="IconWhiteBtn" Content="Light" Click="IconColor_White_Click" ToolTip="White Icon / Dark Canvas" Padding="10,4" FontSize="11" Margin="0,0,3,0" Background="#536FD0" BorderBrush="#6F8AF0"/>
    <Button x:Name="IconBlackBtn" Content="Dark" Click="IconColor_Black_Click" ToolTip="Black Icon / Light Canvas" Padding="10,4" FontSize="11" Margin="0,0,3,0"/>
   </StackPanel>
   <TextBlock x:Name="CountText" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0" Text="0 icons"/>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
    <Grid>
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="ICON LIBRARY" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="3,2,3,10"/>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="PrevPageBtn" Content="◀ Prev" Click="PrevPage_Click" Padding="8,3" FontSize="11" Margin="0,0,3,0"/>
        <Button x:Name="NextPageBtn" Content="Next ▶" Click="NextPage_Click" Padding="8,3" FontSize="11" Margin="0,0,3,0"/>
        <Button x:Name="LoadMoreBtn" Content="+ Load 500 More" Click="LoadMore_Click" Padding="8,3" FontSize="11" Background="#536FD0" BorderBrush="#6F8AF0"/>
       </StackPanel>
       <TextBlock x:Name="PageInfoText" Text="Page 1 of 1" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <ListBox x:Name="IconList" SelectionChanged="IconList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Border Width="118" Height="108" Margin="3" Background="#222630" BorderBrush="#363C49" BorderThickness="1" CornerRadius="8" Padding="6">
          <StackPanel VerticalAlignment="Center">
           <Border Width="48" Height="48" Background="#15171D" CornerRadius="7" HorizontalAlignment="Center" Margin="0,0,0,6" Padding="4"><Image Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding FullPath}" Loaded="IconThumbnail_Loaded"/></Border>
           <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="106"/>
           <TextBlock Text="{Binding Style}" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
     <Border x:Name="LoadingOverlay" Background="#EE1B1E25" CornerRadius="8" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
       <ProgressBar x:Name="CatalogProgressBar" IsIndeterminate="True" Height="6" Width="220" Margin="0,0,0,12" Foreground="{StaticResource Accent}"/>
       <TextBlock x:Name="CatalogLoadingText" Text="Loading icon library..." Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
       <TextBlock x:Name="CatalogLoadingSubtext" Text="Please wait while icons are indexed" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="SELECTED ICON" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
      <TabControl Height="440" Margin="0,10,0,12">
       <TabItem Header="Preview">
        <DockPanel Margin="0,4,0,0">
         <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,6">
          <TextBlock Text="Zoom:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
          <Slider x:Name="PreviewZoomSlider" Minimum="0.5" Maximum="4.0" Value="1.0" Width="85" VerticalAlignment="Center" ValueChanged="PreviewZoomSlider_ValueChanged" ToolTip="Zoom preview image"/>
          <TextBlock x:Name="PreviewZoomText" Text="100%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" Margin="3,0,6,0" Width="36"/>
          <Button Content="Reset" Click="ResetPreviewZoom_Click" ToolTip="Reset Zoom to 100%" Padding="6,2" FontSize="11" Margin="0,0,8,0"/>
          <TextBlock Text="Canvas:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
          <Button x:Name="CanvasGridBtn" Content="Grid" Click="PreviewBg_Checker_Click" ToolTip="Dark Gray Mesh (Transparent Layer Grid)" Padding="8,2" FontSize="11" Margin="0,0,3,0" Background="#536FD0" BorderBrush="#6F8AF0"/>
          <Button x:Name="CanvasWhiteBtn" Content="Light" Click="SetBgColor_White_Click" ToolTip="Solid White Canvas" Padding="8,2" FontSize="11" Margin="0,0,3,0"/>
          <Button x:Name="CanvasBlackBtn" Content="Dark" Click="SetBgColor_Black_Click" ToolTip="Solid Dark Canvas" Padding="8,2" FontSize="11"/>
         </WrapPanel>
         <Border x:Name="PreviewBorder" Background="{StaticResource CheckerboardBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="8" ClipToBounds="True" PreviewMouseWheel="PreviewBorder_PreviewMouseWheel">
          <Grid>
           <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
             <Image x:Name="PreviewImage" Stretch="Uniform" Margin="18">
              <Image.LayoutTransform>
               <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
              </Image.LayoutTransform>
             </Image>
            </Grid>
           </ScrollViewer>
           <TextBlock x:Name="PreviewPlaceholder" Text="Choose an SVG from your library" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="15"/>
          </Grid>
         </Border>
        </DockPanel>
       </TabItem>
       <TabItem Header="SVG Source">
        <Grid Background="{StaticResource PanelBg}">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Width" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="2,0,2,2"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Height" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="2,0,2,2"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="viewBox" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="2,0,2,2"/>
          <TextBox x:Name="SvgWidthBox" Grid.Row="1" Grid.Column="0" Margin="2" Padding="4" ToolTip="SVG width attribute"/>
          <TextBox x:Name="SvgHeightBox" Grid.Row="1" Grid.Column="1" Margin="2" Padding="4" ToolTip="SVG height attribute"/>
          <TextBox x:Name="SvgViewBoxBox" Grid.Row="1" Grid.Column="2" Margin="2" Padding="4" ToolTip="SVG viewBox attribute"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Fill" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="2,2,2,2"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Stroke" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="2,2,2,2"/>
          <TextBox x:Name="SvgFillBox" Grid.Row="3" Grid.Column="0" Margin="2" Padding="4" ToolTip="Fill attribute / color (e.g. #000000 or none)"/>
          <TextBox x:Name="SvgStrokeBox" Grid.Row="3" Grid.Column="1" Margin="2" Padding="4" ToolTip="Stroke attribute / color (e.g. currentColor or none)"/>
          <Button Grid.Row="3" Grid.Column="2" Content="Apply properties" Click="ApplySvgProperties_Click" Margin="2" Padding="5,3"/>
         </Grid>
         <TextBox x:Name="SvgSourceBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="11" Padding="8" MinHeight="180" IsReadOnly="False" SpellCheck.IsEnabled="False" LostFocus="SvgSourceBox_LostFocus"/>
         <DockPanel Grid.Row="2" Margin="0,6,0,0">
          <CheckBox x:Name="WordWrapCheck" Content="Word wrap" IsChecked="True" VerticalAlignment="Center" Margin="2,0,0,0" Checked="WordWrapCheck_Changed" Unchecked="WordWrapCheck_Changed" ToolTip="Wrap long lines in SVG source"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
           <Button Content="Format XML" Click="FormatSvgXml_Click" ToolTip="Re-indent and format XML structure"/>
          <Button Content="Reset" Click="ResetSvg_Click"/>
          <Button Content="Apply &amp; Preview" Click="ApplySvg_Click" Background="#536FD0" BorderBrush="#6F8AF0"/>
          </StackPanel>
         </DockPanel>
        </Grid>
       </TabItem>
      </TabControl>
      <TextBlock x:Name="SelectedName" Text="No icon selected" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="SelectedPath" Text="Open a folder containing SVG files to begin." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,14"/>
      <TextBlock Text="RASTER EXPORT" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <DockPanel Margin="0,0,0,7">
       <Button DockPanel.Dock="Right" Content="Save preset…" Click="SavePreset_Click" Padding="8,5" Margin="5,0,0,0"/>
       <ComboBox x:Name="ExportPresetBox" Height="32" SelectionChanged="ExportPreset_SelectionChanged" ToolTip="Choose a saved export preset"/>
      </DockPanel>
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" Margin="0,0,4,0">
        <TextBlock Text="Format" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,2,3"/>
        <ComboBox x:Name="ExportFormatBox" Height="32" SelectedIndex="0" SelectionChanged="ExportFormat_SelectionChanged">
         <ComboBoxItem Content="PNG"/><ComboBoxItem Content="WebP"/><ComboBoxItem Content="JPEG"/>
        </ComboBox>
       </StackPanel>
       <StackPanel Grid.Column="1" Margin="4,0,0,0">
        <TextBlock Text="Square size (px)" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,2,3"/>
        <TextBox x:Name="ExportSizeBox" Text="512" Height="32" VerticalContentAlignment="Center"/>
       </StackPanel>
      </Grid>
      <DockPanel Margin="0,0,0,5">
       <TextBlock Text="Quality" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
       <TextBlock x:Name="QualityValueText" Text="90%" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
      </DockPanel>
      <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="90" TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="QualitySlider_ValueChanged" Margin="0,0,0,7"/>
      <TextBlock Text="Background color (hex)" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,2,3"/>
      <DockPanel Margin="0,0,0,0">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
        <Button Content="White" Click="SetBgColor_White_Click" Padding="10,4" FontSize="11"/>
        <Button Content="Black" Click="SetBgColor_Black_Click" Padding="10,4" FontSize="11" Margin="4,0,0,0"/>
       </StackPanel>
       <TextBox x:Name="BackgroundColorBox" Text="#FFFFFF" Height="32" VerticalContentAlignment="Center" TextChanged="BackgroundColorBox_TextChanged"/>
      </DockPanel>
      <CheckBox x:Name="TransparentCheck" Content="Transparent background (PNG/WebP)" IsChecked="True" Margin="0,8,0,8" Foreground="{StaticResource TextMain}"/>
      <Button Content="Export current image…" Click="ExportImage_Click" Height="40" Background="#536FD0" BorderBrush="#6F8AF0"/>
      <Border Height="1" Background="#363C49" Margin="0,8,0,8"/>
      <TextBlock Text="WINDOWS ICON" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <TextBlock Text="512 × 512 master PNG · ICO entries: 16, 24, 32, 48, 64, 128, 256 px" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
      <Button Content="Export multi-size ICO + master PNG" Click="ExportIco_Click" Height="36" Background="#536FD0" BorderBrush="#6F8AF0"/>
      <Button Content="Export SVG copy" Click="ExportSvg_Click"/>
      <Border Height="1" Background="#363C49" Margin="0,8,0,8"/>
      <TextBlock Text="ANDROID APP PACK" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <TextBlock Text="res/ mipmap densities (mdpi to xxxhdpi) + adaptive XML + 512px Web Master" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
      <Button Content="Export Android app icon pack (ZIP)…" Click="ExportAndroidPack_Click" Height="36" Background="#536FD0" BorderBrush="#6F8AF0"/>
      <Border Height="1" Background="#363C49" Margin="0,8,0,8"/>
      <TextBlock Text="CHROME EXTENSION &amp; PWA PACK" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <TextBlock Text="16, 32, 48, 128, 512 px PNGs + manifest.json snippet" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
      <Button Content="Export Chrome / PWA icon pack (ZIP)…" Click="ExportChromePack_Click" Height="36" Background="#536FD0" BorderBrush="#6F8AF0"/>
      <TextBlock Text="PNG/WebP retain transparency when enabled. JPEG always uses the selected background color." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="4,8,4,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="2,10,2,0">
   <TextBlock x:Name="StatusText" Text="Ready · Open an SVG icon folder to start" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <TextBlock DockPanel.Dock="Right" Text=".NET 10 · Windows desktop" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
  </DockPanel>
 </Grid>
</Window>
